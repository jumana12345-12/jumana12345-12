  let exportMode = false;
  btn.addEventListener('click', () => {
    exportMode = !exportMode;
    document.body.classList.toggle('export-mode', exportMode);
    if (exportMode) {
      btn.textContent = '↩️ رجوع للعرض العادي';
      window.scrollTo(0, 0);
    } else {
      btn.textContent = '📸 وضع التصدير (1600×900)';
    }
  });
 
  if (window.location.search.includes('export')) {
    btn.click();
  }
